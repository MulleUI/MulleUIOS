# Valgrind suppressions for MulleUIOS tests.
#
# All of these match only call stacks that pass through the vendor graphics
# libraries named below, so leaks/errors originating in MulleUI, MulleGLFW,
# the Objective-C runtime or the tests themselves are still reported.
#
# Rationale: every available GL backend leaks a little EGL/driver state that
# is not reclaimed by eglTerminate (NVIDIA proprietary, Mesa EGL/llvmpipe and
# OSMesa alike), and the NVIDIA Wayland EGL layer issues write() syscalls that
# valgrind cannot model. See MulleUIOS test notes. GLFW's own Wayland leaks
# were fixed by using glfw 3.5.1 and are deliberately NOT suppressed.

# --- NVIDIA proprietary EGL driver -----------------------------------------

{
   mulle-uios-nvidia-egl-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libEGL_nvidia.so*
   ...
}

{
   mulle-uios-nvidia-egl-wayland-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libnvidia-egl-wayland.so*
   ...
}

{
   mulle-uios-nvidia-other-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libnvidia-*.so*
   ...
}

# libdbus allocations pulled in through the NVIDIA EGL Wayland layer
{
   mulle-uios-nvidia-dbus-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libdbus-1.so*
   ...
   obj:*/libEGL_nvidia.so*
   ...
}

# NVIDIA EGL Wayland layer issues write() syscalls valgrind cannot model
{
   mulle-uios-nvidia-egl-wayland-write
   Memcheck:Param
   write(buf)
   ...
   obj:*/libnvidia-egl-wayland.so*
   ...
}

# glibc get_nprocs() overlap false positive reached through the NVIDIA EGL
# core (Wayland EGL path). Vendor code, not fixable downstream. Matched via the
# vendor object so error stacks not passing through it are still reported.
{
   mulle-uios-nvidia-eglcore-getnprocs-overlap
   Memcheck:Overlap
   ...
   obj:*/libnvidia-eglcore.so*
   ...
}

# --- Mesa software EGL (llvmpipe) / gallium --------------------------------

{
   mulle-uios-mesa-egl-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libEGL_mesa.so*
   ...
}

{
   mulle-uios-mesa-gallium-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libgallium*.so*
   ...
}

# --- GLFW bundled library --------------------------------------------------
#
# glfw's own Wayland leaks are fixed (glfw 3.5.1 window teardown and a
# MulleGLFW os_deinitialize drain of the glfwPostEmptyEvent sync callback), so
# nothing from MulleGLFW is suppressed here.

# --- OSMesa software rendering ---------------------------------------------

{
   mulle-uios-osmesa-leak
   Memcheck:Leak
   match-leak-kinds: definite,possible
   ...
   obj:*/libOSMesa.so*
   ...
}
